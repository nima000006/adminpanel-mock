{
  "compilerOptions": {
    "target": "es2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    // Stricter checks - enable gradually
    // "noImplicitReturns": true, // Enable when ready to fix all functions
    // "noPropertyAccessFromIndexSignature": true, // Enable when ready for stricter object access
    // "exactOptionalPropertyTypes": false, // Can break existing code
    // "strictNullChecks": true, // Enable when ready for strict null checks
    // "noUncheckedIndexedAccess": true, // Enable when ready for stricter indexing

    /* Aliases */
    // "baseUrl": "./",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./src/assets/*"],
      "@infra/*": ["./src/infrastructure/*"],
      "@pages/*": ["./src/pages/*"]
    },

    /* Optimize helper imports */
    "importHelpers": true,

    /* Performance & Optimization */
    "incremental": false,
    // "assumeChangesOnlyAffectDirectDependencies": true,

    /* Type definitions */
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src",
    "./eslint.config.js",
    "./cypress.config.ts",
    "**/*.cy.ts",
    "cypress"
  ],
  "exclude": ["node_modules", "dist", "dev-dist", "stats.html"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
