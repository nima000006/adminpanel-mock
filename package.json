{
  "name": "adminpanel",
  "private": true,
  "version": "1.0.86",
  "type": "module",
  "engines": {
    "node": ">=24.1.0"
  },
  "scripts": {
    "local": "vite --host",
    "build": "tsc && vite build",
    "stage": "tsc && vite build --mode staging",
    "dev": "tsc && vite build --mode dev",
    "uat": "tsc && vite build --mode uat",
    "lint": "eslint .",
    "preview": "vite preview",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "prepare": "husky install",
    "test": "vitest run",
    "test:unit": "vitest --project unit",
    "test:browser": "vitest --project browser",
    "test:watch": "vitest run --watch",
    "coverage": "vitest run --coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:component": "cypress open --component",
    "cypress:e2e": "npx cypress open --e2e",
    "test:e2e": "start-server-and-test local http://localhost:3002 cypress:open",
    "create-icons": "gulp --cwd ./icons",
    "analyze-bundle": "npx vite-bundle-analyzer dist",
    "clean": "rm -rf dist dev-dist node_modules/.vite",
    "clean:install": "rm -rf node_modules package-lock.json && npm install",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint-staged": "lint-staged",
    "pre-commit": "lint-staged",
    "commit": "git-cz",
    "size-check": "npx size-limit",
    "generate:mocks": "node scripts/generateFeatureMocks.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.2",
    "@mui/x-charts": "^8.11.3",
    "@reduxjs/toolkit": "^2.9.0",
    "@sentry/react": "^9.10.1",
    "@tailwindcss/vite": "^4.3.0",
    "@videojs/react": "10.0.0-beta.23",
    "@xyflow/react": "^12.5.1",
    "@yudiel/react-qr-scanner": "^2.4.1",
    "antd": "^6.6.4",
    "chart.js": "^4.4.9",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "idb": "^8.0.3",
    "jalali-moment": "^3.3.11",
    "jalali-plugin-dayjs": "^1.1.4",
    "leaflet": "^1.9.4",
    "moment": "^2.30.1",
    "nprogress-v2": "^1.1.10",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.0",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^5.0.0",
    "react-fast-compare": "^3.2.2",
    "react-highlight-words": "^0.21.0",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.7",
    "react-leaflet": "^5.0.0",
    "react-multi-date-picker": "^4.1.2",
    "react-qr-code": "^2.0.21",
    "react-redux": "^9.2.0",
    "react-router": "^8.3.0",
    "react-to-print": "^3.0.5",
    "react-toastify": "^11.0.5",
    "redux": "^5.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "usehooks-ts": "^3.1.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@cypress/react": "^9.0.1",
    "@cypress/vite-dev-server": "^6.0.3",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@rollup/plugin-strip": "^3.0.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.1.1",
    "@types/leaflet": "^1.9.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-highlight-words": "^0.20.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.6.4",
    "cypress": "^14.5.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "gulp": "^5.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.4",
    "gulp-svgmin": "^4.1.0",
    "husky": "^8.0.3",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.2.6",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.77.2",
    "start-server-and-test": "^2.0.11",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.2.1",
    "vite-plugin-imp": "^2.4.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^3.2.4",
    "vitest-browser-react": "^1.0.1"
  }
}
